# ===== NexusBot Configuration =====

# La session WhatsApp vit dans le dossier ./session/ (créé par `npm run pair`
# ou au premier `npm start` en scannant le QR). Rien à mettre ici.

# Préfixe des commandes (ex: . ! #)
PREFIX=.

# Nom du bot
BOT_NAME=NexusBot

# Numéros administrateurs (séparés par des virgules, format international sans +)
OWNER_NUMBER=

# Dossier de téléchargement temporaire
TEMP_DIR=./tmp

# ===== Optionnel (fonctionnalités avancées) =====
# Clé API Gemini (pour .chat plus tard)
GEMINI_API_KEY=

# Clé API OpenAI (pour .chat plus tard)
OPENAI_API_KEY=

# Telegram : réception automatique des view-once
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
